# Copy to ".env" (never committed) and set your own values.
# Use the secret Stripe shows for your webhook endpoint (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Any long random string; your app sends it in the X-API-Key header.
API_KEY=replace-with-a-long-random-string
DB_PATH=assinaturas.db
